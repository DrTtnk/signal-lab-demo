{
  "name": "@signal-lab/e2e",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "setup:browser": "playwright install chromium",
    "e2e": "sh ./run.sh",
    "test": "playwright test",
    "test:flow": "playwright test --project=flow"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "eslint": "9.39.5",
    "eslint-plugin-playwright": "2.12.2",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "zod": "4.6.7"
  }
}
