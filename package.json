{
  "name": "signal-lab",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "frontend",
    "tests/e2e",
    "backend/*",
    "tools/*",
    "clients/*"
  ],
  "scripts": {
    "setup": "turbo run setup",
    "setup:browser": "npm run setup:browser --workspace @signal-lab/e2e",
    "check": "turbo run check",
    "build": "turbo run build",
    "fixtures": "npm run fixtures --workspace @signal-lab/fixtures",
    "e2e": "npm run e2e --workspace @signal-lab/e2e",
    "load": "k6 run tests/load/analysis.js"
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "turbo": "2.11.10"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
